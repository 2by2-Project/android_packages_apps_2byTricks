    <string name="custom_dashboard_title">2byTricks</string>
    <!-- Categories -->
    <string name="miscellaneous_title">その他</string>
    <string name="miscellaneous_summary">特別な設定（自己責任で使用してください）</string>
    <string name="about_title">ROM の詳細</string>
    <string name="about_summary">2by2 ROM について</string>
    <!-- Miscellaneous -->
    <string name="category_appearance_title">見た目を変える</string>
    <string name="category_system_title">システム関連</string>
    <!-- Miscellaneous - Appearance -->
    <string name="qs_transparency_title">クイック設定の透明度</string>
    <string name="disable_window_blurs_title">クイック設定のぼかし機能を無効化</string>
    <string name="disable_window_blurs_summary">ぼかし機能を無効にするとパフォーマンスが向上する可能性があります。また、一部デバイスでは最適化によりぼかし機能が強制的に無効になることがあります。</string>
    <!-- Miscellaneous - System -->

    <!-- Google Play Integrity Spoof -->
    <string name="pi_spoof_title">Google Play Integrity の偽装</string>
    <string name="pi_spoof_summary">Google Play Integrity のためにデバイスを異なるモデルとして偽装します</string>

    <!-- Vbmeta hash attestation -->
    <string name="vbmeta_attestation_title">VBMeta 検出の自動修正</string>
    <string name="vbmeta_attestation_summary">起動時にキー認証を実行し、検証済みのブートハッシュを生成します。システムの再起動が必要です。</string>

    <!-- Keybox Data -->
    <string name="keybox_data_title">キーボックス認証のオーバーライド</string>
    <string name="keybox_data_summary">デバイスのキー認証を通過させるため、カスタムキーボックスXMLを適用します</string>
    <string name="keybox_data_loaded_summary">カスタムキーボックスXMLが読み込まれました。削除ボタンを押すとクリアします。</string>
    <string name="keybox_delete_content_description">カスタムキーボックスをクリアする</string>
    <string name="keybox_toast_invalid_file_selected">有効なキーボックスXMLではありません。再度選択してください。</string>
    <string name="keybox_toast_missing_data">有効なキーボックスXMLではありません。認証データが欠落しています。</string>
    <string name="keybox_toast_file_loaded">カスタムキーボックスXMLが読み込まれました</string>
    <string name="keybox_toast_file_cleared">カスタムキーボックスXMLをクリアしました</string>

    <!-- Block attestation even with Keybox Data -->
    <string name="pi_gmscertchain_title">MEETS_STRONG_INTEGRITY を強制しない</string>
    <string name="pi_gmscertchain_summary">有効なカスタム キーボックスからの MEETS_STRONG_INTEGRITY を強制せず、Google Play 整合性スプーフィングを使用することで、Google Pay が動作するようにします</string>

    <!-- Unlock FPS for specific games -->
    <string name="use_games_spoof_title">ゲーム内でより高い FPS 設定を解放する</string>
    <string name="use_games_spoof_summary">より高い FPS 設定を表示させるために、一部のゲームでは異なるモデルとしてデバイスを偽装します</string>

    <!-- Netflix Spoof -->
    <string name="netflix_spoof_title">Netflix 偽装</string>
    <string name="netflix_spoof_summary">Netflix 向けに、異なるモデルとしてデバイスを偽装します</string>

    <!-- Unlimited google photos storage -->
    <string name="use_photos_spoof_title">無制限のフォトストレージ</string>
    <string name="use_photos_spoof_summary">Google フォトアプリでのみ、デバイスを Pixel XL として偽装して、高画質での無制限のバックアップができるようにします</string>

    <!-- Disable camera sounds -->
    <string name="disable_camera_sounds_title">シャッター音の強制無効化</string>
    <string name="disable_camera_sounds_summary">再起動が必要です。いかなる法的問題が発生しても 2by2 Project は責任を負いません。</string>

    <!-- Ignore window secure -->
    <string name="ignore_window_secure_title">ウィンドウのセキュアフラグを無視</string>
    <string name="ignore_window_secure_summary">すべてのアプリへのスクリーンショットや画面録画の制限を解除します。基本的に特別なアプリは録画の際、録画画面は黒く塗り潰されます。いくつかの場合で便利になることがありますが、プライバシー保護が脆弱になる可能性があります。この設定切り替えの後、効果を反映させるにはアプリの再起動が必要になる可能性があります。</string>

    <!-- About -->
    <string name="about_info">2by2 ROMは、主に日本人向けにフォーカスされたカスタムROMです。私たちはLineageOSに基づきクリーンなAOSP体験や追加機能などを提供します。</string>
    <string name="about_website_title">ホームページ</string>
    <string name="about_website_summary">2by2 Project のホームページに移動します</string>
    <string name="about_instagram_summary">2by2 Project 公式 Instagram を開きます</string>
    <string name="about_telegram_summary">2by2 Project コミュニティ チャットを開きます</string>
    <string name="about_github_summary">Github のソースコードを表示します</string>
    <string name="about_contributors_title">2by2 Project チーム</string>
